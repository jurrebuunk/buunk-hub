# The hub's settings for dev/compose.yaml. Throwaway values, for local
# development only; the real ones are sops Secrets in deploy/.
#   set -a; . dev/hub.env; set +a; go run .
HUB_ADDR=127.0.0.1:8080
HUB_PUBLIC_URL=http://localhost:8080
HUB_DATABASE_URL=postgres://hub:hub@localhost:15432/hub
HUB_OIDC_ISSUER=http://localhost:8180/realms/hgd1
HUB_OIDC_CLIENT_ID=hub
HUB_OIDC_CLIENT_SECRET=hub-dev-secret
# base64 of "dev-only-session-key-not-secret!"
HUB_SESSION_KEY=ZGV2LW9ubHktc2Vzc2lvbi1rZXktbm90LXNlY3JldCE=
